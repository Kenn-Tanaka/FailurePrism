{
  "name": "failure-prism",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "FailurePrism: TPDD-Editor (思考展開図エディタ) + VTA-Editor (バリエーションツリー分析エディタ) + LLM-Gateway v2.0 統合パッケージ",
  "type": "module",
  "scripts": {
    "start": "node scripts/server.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:dist": "node scripts/server.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-package.ps1",
    "licenses:update": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^2.1.5"
  }
}
